{
  // 插件源码不在根 tsconfig 的覆盖范围内（根配置 exclude: plugins）：
  // 插件各自用独立 vite（esbuild）构建，只转译不做类型检查，插件内的类型错误长期不可见。
  // 本配置为插件源码提供类型检查入口，由 `npm run typecheck:plugins` 调用。
  //
  // 范围说明：已全量纳入 plugins/**（含 _shared）。历史上这里只收攻防插件，
  // 其余插件共 17 处类型错误长期不可见；2026-10-18 已逐个收敛清零，故扩大为全量。
  // 新增插件请保持 `npx tsc -p tsconfig.plugins.json --noEmit` 通过（CI 已接）。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // 允许 Array.prototype.at 等 ES2022 运行时能力（各插件 vite 构建实际按 ESNext 转译）
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["plugins/**/*.ts", "plugins/**/*.tsx", "plugins/global.d.ts"],
  "exclude": ["node_modules", "bundled-plugins", "got-it"]
}