{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "andeyunhui",
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/andeyunhui.desktop",
        "files": {
          "/usr/share/gnome-shell/extensions/andeyunhui-pin@rosary/extension.js": "linux/gnome-extension/extension.js",
          "/usr/share/gnome-shell/extensions/andeyunhui-pin@rosary/metadata.json": "linux/gnome-extension/metadata.json"
        },
        "depends": [
          "libdbus-1-3",
          "libx11-6",
          "libxinerama1",
          "libpipewire-0.3-0",
          "fonts-noto-cjk",
          "xdg-desktop-portal"
        ],
        "recommends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
