{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "andeyunhui",
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
